{
  "name": "privacy-shield-anonymizer",
  "private": true,
  "version": "1.0.0",
  "description": "Reversible Text Anonymizer for External AI",
  "main": "main.js",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "start": "electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.74.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
